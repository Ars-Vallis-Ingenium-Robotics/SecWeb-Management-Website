@page "/Account/LoginWithEmailCode"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SecWeb.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<LoginWithEmailCode> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Verify Login</PageTitle>

<h1>Verify your login</h1>

<div class="row">
    <div class="col-lg-6">

        <section>

            <StatusMessage Message="@errorMessage" />

            <EditForm Model="Input"
                      method="post"
                      OnValidSubmit="VerifyCodeAsync"
                      FormName="verify-login-code">

                <DataAnnotationsValidator />

                <h2>Enter the code sent to your email.</h2>

                <hr />

                <p class="text-secondary">
                    For your security, SecWeb requires an email
                    verification code before completing your login.
                </p>


                <ValidationSummary class="text-danger"
                                   role="alert" />


                <div class="form-floating mb-3">

                    <InputText @bind-Value="Input.Code"
                               id="Input.Code"
                               class="form-control"
                               autocomplete="one-time-code"
                               inputmode="numeric"
                               maxlength="10"
                               aria-required="true"
                               placeholder="Verification code" />

                    <label for="Input.Code"
                           class="form-label">

                        Verification Code

                    </label>

                    <ValidationMessage For="() => Input.Code"
                                       class="text-danger" />

                </div>


                <button type="submit"
                        class="w-100 btn btn-lg btn-primary">

                    Verify and Log In

                </button>


                <div class="mt-3">

                    <a href="/Account/Login">
                        Back to login
                    </a>

                </div>

            </EditForm>

        </section>

    </div>
</div>


@code {

    private string? errorMessage;


    [SupplyParameterFromForm]
    private InputModel Input { get; set; }


    public LoginWithEmailCode()
    {
        Input = new();
    }


    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }


    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }


    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        // Identity stores the user who passed the password stage
        // in a temporary two-factor cookie.
        ApplicationUser? user =
            await SignInManager
                .GetTwoFactorAuthenticationUserAsync();


        if (user == null)
        {
            RedirectManager.RedirectTo(
                "Account/Login");
        }
    }


    private async Task VerifyCodeAsync()
    {
        string code =
            Input.Code
                .Replace(" ", string.Empty)
                .Replace("-", string.Empty);


        SignInResult result =
            await SignInManager.TwoFactorSignInAsync(
                TokenOptions.DefaultEmailProvider,
                code,
                RememberMe,
                rememberClient: false);


        if (result.Succeeded)
        {
            Logger.LogInformation(
                "User logged in after email verification.");

            RedirectManager.RedirectTo(ReturnUrl);

            return;
        }


        if (result.IsLockedOut)
        {
            Logger.LogWarning(
                "User account locked out during email verification.");

            RedirectManager.RedirectTo(
                "Account/Lockout");

            return;
        }


        errorMessage =
            "Error: The verification code is invalid or has expired.";
    }


    private sealed class InputModel
    {
        [Required]
        [Display(Name = "Verification code")]
        public string Code { get; set; } = "";
    }
}
    // =========================================================
    // DISPLAY HELPERS
    // =========================================================

    private static string GetDisplayName(
        ApplicationUser? user)
    {
        if (user == null)
        {
            return "Unknown User";
        }


        string fullName =
            $"{user.FirstName} {user.LastName}"
                .Trim();


        if (!string.IsNullOrWhiteSpace(
            fullName))
        {
            return fullName;
        }


        return user.Email ??
            "Unknown User";
    }


    private static string GetTeamDisplayName(
        ProjectTeam team)
    {
        return team.Project == null

            ? team.Name

            : $"{team.Project.Name} - {team.Name}";
    }


    private string GetCurrentTeamDisplayName()
    {
        return meeting?.Team == null

            ? "Unassigned"

            : GetTeamDisplayName(
                meeting.Team);
    }


    // =========================================================
    // TASK ROW STYLE
    // =========================================================

    private static string GetTaskRowClass(
        MeetingTask task)
    {
        string classes =
            "list-group-item list-group-item-action";


        if (task.SubmittedAtUtc.HasValue)
        {
            classes +=
                " list-group-item-success";
        }


        return classes;
    }


